    logFile.printf("%s,%.2f,%u,%d,%d,%.1f,%d\n", realTime.c_str(), virtualOdometer, rpm, currentSpeed, coolant, voltage, iat);
    logFile.close();
    Serial.println("Write SD Success!"); // ส่งหลักฐานฟ้องทางคอมพิวเตอร์ว่าบันทึกสำเร็จจริง
  } else {
