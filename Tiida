static void notifyCallback(BLERemoteCharacteristic* pBLERemoteCharacteristic, uint8_t* pData, size_t length, bool isNotify) {
  for (size_t i = 0; i < length; i++) { if ((char)pData[i] == '>') dataReceived = true; else obdResponse += (char)pData[i]; }
}
void sendOBDCommand(String cmd) { if (!connected || pWriteChar == nullptr) return; obdResponse = ""; dataReceived = false; cmd += "\r"; pWriteChar->writeValue((uint8_t*)cmd.c_str(), cmd.length(), false); }
long hexToDec(String hexStr) { return strtol(hexStr.c_str(), NULL, 16); }

bool connectToOBD2() {
    BLEAddress obdAddress(target_mac); pClient = BLEDevice::createClient();
    if (!pClient->connect(obdAddress)) return false;
    pClient->setMTU(512); BLERemoteService* pRemoteService = pClient->getService(serviceUUID); if (pRemoteService == nullptr) return false;
    pNotifyChar = pRemoteService->getCharacteristic(charUUID); pWriteChar = pRemoteService->getCharacteristic(writeUUID);
    if (pNotifyChar == nullptr || pWriteChar == nullptr) return false;
    if (pNotifyChar->canNotify()) pNotifyChar->registerForNotify(notifyCallback);
    return true;
}

String getFormattedTime() {
  struct tm timeinfo;
  if(!getLocalTime(&timeinfo)) return "2026-10-14 00:00:00";
  char timeFormatBuf[32];
  strftime(timeFormatBuf, sizeof(timeFormatBuf), "%Y-%m-%d %H:%M:%S", &timeinfo);
  return String(timeFormatBuf);
}

void updateClockString() {
  struct tm timeinfo;
  if(getLocalTime(&timeinfo)){
    char clockBuf[16]; strftime(clockBuf, sizeof(clockBuf), "%H:%M", &timeinfo);
    timeTimeString = String(clockBuf);
  }
}

