void logDataToSD() {
  if (!sdCardReady) return; // หากตอนเริ่มระบบเปิดการ์ดไม่ผ่าน จะไม่สั่งทำงานเพื่อกันบอร์ดเอ๋อ
  
  File logFile = SD.open(currentLogFile, FILE_APPEND);
