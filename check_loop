void loop() {
  // ⚠️ 1. ย้ายการคำนวณส่วนต่างเวลา (Time Elapsed) ขึ้นมาไว้บนสุดเพื่อความแม่นยำของระบบไมล์และน้ำมัน
  unsigned long currentTime = millis();
  float timeElapsedHours = (currentTime - lastFuelCalcTime) / 3600000.0;
  lastFuelCalcTime = currentTime;

  // =======================================================
  // 🟢 [สำหรับทดสอบในบ้าน] หากต้องการใช้ในรถจริง ให้คอมเมนต์ (ใส่ //) ปิดบล็อกนี้
  // =======================================================
  /* 
  connected = true;       
  currentSpeed = 80;      
  rpm = 2500;             
  coolant = 85;           
  voltage = 14.0;         
  stft = 1.2;             
  ltft = -0.5;
  mafGps = 4.5;           
  */
  // =======================================================

  // ⚠️ 2. เคลียร์สลับบัส SPI ให้ระบบทัชสกรีนตื่นตัวก่อนเริ่มอ่านค่า
  digitalWrite(15, HIGH); // ปิดบัสหน้าจอ
  digitalWrite(5, HIGH);  // ปิดบัส SD Card
  digitalWrite(33, LOW);  // เปิดบัสทัชสกรีนให้พร้อมทำงานเด็ดขาด
  delayMicroseconds(10);

  // --- 1. ระบบเช็กทัชสกรีนสลับหน้าจอ (ทำงานไวขึ้นทันที ไม่ต้องกดแช่) ---
  int touchX = 0, touchY = 0;
  if (lcd.getTouch(&touchX, &touchY)) {
    // 🔘 ปุ่ม NEXT ขวาล่างสุด (ขยายพิกัดแนวตั้ง/แนวนอนให้จิ้มโดนง่ายขึ้น)
    if (touchX >= 180 && touchX <= 320 && touchY >= 160 && touchY <= 240) {
      if (millis() - lastPagePress > 250) { // ลดดีเลย์เหลือ 250ms เพื่อความฉับไว
        lastPagePress = millis();
        currentPage++;
        if (currentPage > 4) currentPage = 1;
        
        lcd.fillScreen(TFT_BLACK); // ล้างเฟรมจอเพื่อวาดหน้าปัดชุดถัดไปทันที
        Serial.printf("⏩ ดีดเปลี่ยนหน้าจอทันใจ สลับไปหน้าย่อยที่: %d\n", currentPage);
      }
    }

    // ปุ่มทัชสกรีน RESET TRIP (หน้า 4 ซ้ายล่าง)
    if (currentPage == 4 && touchX >= 0 && touchX <= 120 && touchY >= 180 && touchY <= 240) {
      if (millis() - lastPagePress > 400) {
        lastPagePress = millis();
        tripKm = 0.0;
        tripFuelLitres = 0.0;
        tripKpl = 0.0;
        tripKplValid = false;
        lcd.fillScreen(TFT_BLACK);
        Serial.println("🔄 Reset Trip Data Successfully");
      }
    }
  }

  // เคลียร์บัสทัชสกรีนกลับคืนระบบหลักหลังจากอ่านค่าเสร็จ
  digitalWrite(33, HIGH); 
  delayMicroseconds(10);
  
  // --- 2. ลูปยิงสลับคำสั่งวิเคราะห์ PIDs จริงจากเครื่องยนต์ Nissan Tiida ---
  if (connected) {
    static unsigned long lastQueryTime = 0; static bool waitingForData = false;
    
    // ⚠️ จัดระเบียบบัส SPI ก่อนคุยกับระบบบลูทูธ/OBD คำสั่งสั้นๆ
    digitalWrite(15, HIGH); // ปิดบัสหน้าจอ 
    digitalWrite(5, HIGH);  // ปิดบัส SD Card
    digitalWrite(33, HIGH); // ปิดบัสทัชสกรีนชั่วคราว
    
    if (!waitingForData && (millis() - lastQueryTime > 40)) {
      lastQueryTime = millis(); waitingForData = true;
      switch (obdState) {
        case GET_RPM:     sendOBDCommand("010C"); break;
        case GET_SPEED:   sendOBDCommand("010D"); break;
        case GET_COOLANT: sendOBDCommand("0105"); break;
        case GET_VOLTS:   sendOBDCommand("ATRV"); break;
        case GET_IAT:     sendOBDCommand("010F"); break;
        case GET_STFT:    sendOBDCommand("0106"); break;
        case GET_LTFT:    sendOBDCommand("0107"); break;
        case GET_VACUUM:  sendOBDCommand("010B"); break;
        case GET_LOAD:    sendOBDCommand("0104"); break;
        case GET_O2:      sendOBDCommand("0114"); break;
        case GET_MAF:     sendOBDCommand("0110"); break;
      }
    }
    
    if (waitingForData && dataReceived) {
      waitingForData = false; obdResponse.replace("\r", ""); obdResponse.replace("\n", ""); obdResponse.replace(" ", "");
      if (obdResponse.indexOf("41") >= 0) {
        int idx = obdResponse.indexOf("41"); String dataBytes = obdResponse.substring(idx + 4);
        switch (obdState) {
          case GET_RPM: rpm = (hexToDec(dataBytes.substring(0, 2)) * 256.0 + hexToDec(dataBytes.substring(2, 4))) / 4.0; obdState = GET_SPEED; break;
          case GET_SPEED: currentSpeed = hexToDec(dataBytes.substring(0, 2)); obdState = GET_COOLANT; break;
          case GET_COOLANT: coolant = hexToDec(dataBytes.substring(0, 2)) - 40; obdState = GET_VOLTS; break;
          case GET_IAT: iat = hexToDec(dataBytes.substring(0, 2)) - 40; obdState = GET_STFT; break;
          case GET_STFT: stft = (hexToDec(dataBytes.substring(0, 2)) - 128) * 100.0 / 128.0; obdState = GET_LTFT; break;
          case GET_LTFT: ltft = (hexToDec(dataBytes.substring(0, 2)) - 128) * 100.0 / 128.0; obdState = GET_VACUUM; break;
          case GET_VACUUM: {
            int M_idx = obdResponse.indexOf("410B");
            if (M_idx >= 0) { float mapKpa = strtol(obdResponse.substring(M_idx + 4, M_idx + 6).c_str(), NULL, 16); vacuum = (101.3 - mapKpa) * 0.2953; if (vacuum < 0.0) vacuum = 0.0; }
            obdState = GET_LOAD; break;
          }
          case GET_LOAD: engineLoad = hexToDec(dataBytes.substring(0, 2)) * 100.0 / 255.0; obdState = GET_O2; break;
          case GET_O2: o2Sensor = hexToDec(dataBytes.substring(0, 2)) / 200.0; obdState = GET_MAF; break;
          case GET_MAF: {
            mafGps = (hexToDec(dataBytes.substring(0, 2)) * 256.0 + hexToDec(dataBytes.substring(2, 4))) / 100.0; 
            obdState = GET_RPM; break;
          }
        }
      } else if (obdState == GET_VOLTS) {
        obdResponse.replace("V", ""); voltage = obdResponse.toFloat(); if(voltage == 0.0) voltage = 14.1;
        obdState = GET_IAT;
      } else { obdState = GET_RPM; }
    }

    // ⚠️ ลบตัวแปร currentTime และ timeElapsedHours ตัวซ้ำซ้อนออก เพื่อใช้ค่าชุดบนร่วมกันอย่างถูกต้อง 100%

    // 1. ส่วนคำนวณระยะทางไมล์สะสม (ทำงานร่วมกับค่าเวลาที่คำนวณไว้จากส่วนที่ 1)
    if (currentSpeed > 0) {
      virtualOdometer += (float)currentSpeed * timeElapsedHours;
      tripKm += (float)currentSpeed * timeElapsedHours;
    }

    // 2. ส่วนคำนวณค่าน้ำมัน 
    if (mafGps > 0.0) {
      float fuelGps = mafGps / 14.7;
      float fuelLitresPerSecond = fuelGps / 740.0;
      tripFuelLitres += fuelLitresPerSecond * (timeElapsedHours * 3600.0);
    }

    if (tripFuelLitres > 0.005 && tripKm > 0.02) {
      tripKpl = tripKm / tripFuelLitres;
      tripKplValid = true;
    } else {
      tripKplValid = false;
    }

    simulatedGear = (currentSpeed < 20) ? 1 : (currentSpeed < 50) ? 2 : (currentSpeed < 85) ? 3 : (currentSpeed < 110) ? 4 : 5;
  }
  // --- 3. ส่วนเรนเดอร์จัดวางองค์ประกอบลงบนแผ่นหน้าจอ ---
  char buf[48]; 
  uint16_t themeColor = lcd.color565(173, 255, 47);
  
  if (millis() - lastScreenUpdateTime > 250) { 
    lastScreenUpdateTime = millis();

    // ⚠️ จัดระเบียบบัส SPI เปิดบัสหน้าจอ (ขา 15) ล็อกตัวอื่นเป็น HIGH ไว้ก่อน
    digitalWrite(5, HIGH);  // ปิดบัส SD
    digitalWrite(33, HIGH); // ปิดบัสทัช
    digitalWrite(15, LOW);  // เปิดบัสจอให้วาดกราฟิกได้อย่างเต็มที่

    // 🔴 หน้าที่ 1 — หน้าปัดหลักตามภาพตัวอย่าง
    if (currentPage == 1) {
      drawTopTachoBarDirect(rpm);

      // แถบสถานะด้านบน
      lcd.setFont(&fonts::Font0);
      lcd.setTextSize(1);
      lcd.setTextColor(themeColor, TFT_BLACK); lcd.drawString("REDLINE", 12, 10);
      lcd.setTextColor(TFT_GREEN, TFT_BLACK);  lcd.drawString(connected ? "OBD ONLINE" : "OBD OFFLINE", 105, 10);
      lcd.setTextColor(TFT_WHITE, TFT_BLACK);  lcd.drawString("12:35", 195, 10);

      // กรอบแสดงค่าหลักด้านซ้าย
      const uint16_t panelLine = lcd.color565(50, 190, 210);
      lcd.drawRoundRect(8, 55, 215, 172, 8, panelLine);

      // RPM — 7-segment ขนาดใหญ่ที่สุด
      lcd.fillRect(10, 65, 160, 48, TFT_BLACK);
      lcd.setFont(&fonts::Font7);
      lcd.setTextColor(TFT_WHITE, TFT_BLACK);
      snprintf(buf, sizeof(buf), "%u", (unsigned int)rpm);
      lcd.drawString(buf, 28, 66);
      lcd.setFont(&fonts::Font0);
      lcd.setTextSize(1);
      lcd.setTextColor(themeColor, TFT_BLACK);
      lcd.drawString("RPM", 168, 88);

      // SPEED — 7-segment ขนาดกลาง
      lcd.fillRect(15, 130, 150, 40, TFT_BLACK);
      lcd.setFont(&fonts::Font7);
      lcd.setTextSize(0.58);
      lcd.setTextColor(TFT_WHITE, TFT_BLACK);
      snprintf(buf, sizeof(buf), "%03d", currentSpeed);
      lcd.drawString(buf, 45, 130);
      lcd.setFont(&fonts::Font0);
      lcd.setTextSize(1);
      lcd.setTextColor(TFT_WHITE, TFT_BLACK);
      lcd.drawString("Km/h", 168, 146);

      // ODOMETER — 7-segment ขนาดเล็กที่สุด
      lcd.fillRect(15, 180, 200, 30, TFT_BLACK);
      lcd.setFont(&fonts::Font7);
      lcd.setTextSize(0.40);
      lcd.setTextColor(TFT_WHITE, TFT_BLACK);
      snprintf(buf, sizeof(buf), "%.0f", virtualOdometer);
      lcd.drawString(buf, 65, 180);

      // กล่องข้อมูลด้านขวา
      int rx = 232, rw = 82, rh = 54;
      lcd.drawRoundRect(rx, 35, rw, rh, 6, panelLine);
      lcd.setFont(&fonts::Font0); lcd.setTextSize(1);
      lcd.setTextColor(themeColor, TFT_BLACK); lcd.drawString("COOLANT", rx+6, 40);
      lcd.setFont(&fonts::Font4); lcd.setTextSize(1);
      lcd.setTextColor(coolant >= 98 ? TFT_RED : TFT_WHITE, TFT_BLACK);
      snprintf(buf, sizeof(buf), "%2d", coolant); lcd.drawString(buf, rx+6, 52);
      lcd.setFont(&fonts::Font0); lcd.drawString("C", rx+54, 62);
      lcd.drawFastHLine(rx+6, 35 + 44, 70, lcd.color565(40, 40, 40));
      int coolantBar = constrain(map(coolant, 0, 120, 0, 70), 0, 70);
      lcd.fillRect(rx+6, 35 + 44, coolantBar, 3, themeColor);

      lcd.drawRoundRect(rx, 96, rw, rh, 6, panelLine);
      lcd.setFont(&fonts::Font0); lcd.setTextColor(themeColor, TFT_BLACK); lcd.drawString("VOLTAGE", rx+6, 101);
      lcd.setFont(&fonts::Font4); lcd.setTextColor(TFT_WHITE, TFT_BLACK);
      snprintf(buf, sizeof(buf), "%4.1f", voltage); lcd.drawString(buf, rx+4, 113);
      lcd.setFont(&fonts::Font0); lcd.drawString("V", rx+66, 123);

      lcd.drawRoundRect(rx, 157, rw, rh, 6, panelLine);
      lcd.setFont(&fonts::Font0); lcd.setTextColor(themeColor, TFT_BLACK); lcd.drawString("INTAKE", rx+6, 162);
      lcd.setFont(&fonts::Font4); lcd.setTextColor(TFT_WHITE, TFT_BLACK);
      snprintf(buf, sizeof(buf), "%2d", iat); lcd.drawString(buf, rx+6, 174);
      lcd.setFont(&fonts::Font0); lcd.drawString("C", rx+54, 184);
    }
    
    // ⚠️ วาดเสร็จแล้ว คืนค่าสัญญาณบัสหน้าจอเป็น HIGH เพื่อปล่อยระบบให้ส่วนอื่นทำงานต่อ
    digitalWrite(15, HIGH); 
  }
// 🟦 หน้าที่ 2
  else if (currentPage == 2) {
    lcd.setFont(&fonts::Font0); lcd.setTextColor(TFT_ORANGE, TFT_BLACK); lcd.drawString("PAGE 2: ECU DIAGNOSTIC DATA MONITOR", 10, 10);
    lcd.drawFastHLine(10, 26, 300, TFT_DARKGREY);
    int bx = 10, bw = 145, bh = 55;
    lcd.drawRoundRect(bx, 35, bw, bh, 4, TFT_DARKGREY); lcd.drawString("STFT BANK 1", bx+8, 40);
    lcd.setFont(&fonts::Font2); lcd.setTextColor(TFT_GREEN, TFT_BLACK); snprintf(buf, sizeof(buf), "%+5.1f %%", stft); lcd.drawString(buf, bx+8, 58);
    lcd.setFont(&fonts::Font0); lcd.setTextColor(TFT_WHITE, TFT_BLACK);
    lcd.drawRoundRect(bx+155, 35, bw, bh, 4, TFT_DARKGREY); lcd.drawString("LTFT BANK 1", bx+163, 40);
    lcd.setFont(&fonts::Font2); lcd.setTextColor(TFT_GREEN, TFT_BLACK); snprintf(buf, sizeof(buf), "%+5.1f %%", ltft); lcd.drawString(buf, bx+163, 58);
    lcd.setFont(&fonts::Font0); lcd.setTextColor(TFT_WHITE, TFT_BLACK);
    lcd.drawRoundRect(bx, 93, bw, bh, 4, TFT_DARKGREY); lcd.drawString("VACUUM PRESSURE", bx+8, 98);
    lcd.setFont(&fonts::Font2); snprintf(buf, sizeof(buf), "%4.1f inHg", vacuum); lcd.drawString(buf, bx+8, 116);
    lcd.setFont(&fonts::Font0);
    lcd.drawRoundRect(bx+155, 93, bw, bh, 4, TFT_DARKGREY); lcd.drawString("COOLANT TEMP", bx+163, 98);
    lcd.setFont(&fonts::Font2); lcd.setTextColor(TFT_CYAN, TFT_BLACK); snprintf(buf, sizeof(buf), "%3d deg C", coolant); lcd.drawString(buf, bx+163, 116);
    lcd.setFont(&fonts::Font0); lcd.setTextColor(TFT_WHITE, TFT_BLACK);
    lcd.drawRoundRect(bx, 151, bw, bh, 4, TFT_DARKGREY); lcd.drawString("ENGINE LOAD", bx+8, 156);
    lcd.setFont(&fonts::Font2); snprintf(buf, sizeof(buf), "%4.1f %%", engineLoad); lcd.drawString(buf, bx+8, 174);
    lcd.setFont(&fonts::Font0);
    lcd.drawRoundRect(bx+155, 151, bw, bh, 4, TFT_DARKGREY); lcd.drawString("O2 B1S1 VOLTS", bx+163, 156);
    lcd.setFont(&fonts::Font2); lcd.setTextColor(TFT_YELLOW, TFT_BLACK); snprintf(buf, sizeof(buf), "%4.2f V", o2Sensor); lcd.drawString(buf, bx+163, 174);
  }
  // 🟨 หน้าที่ 3
  else if (currentPage == 3) {
    lcd.setFont(&fonts::Font0); lcd.setTextColor(TFT_YELLOW, TFT_BLACK); lcd.drawString("PAGE 3: VEHICLE MAINTENANCE SCHEDULE", 10, 10);
    lcd.drawFastHLine(10, 26, 300, TFT_DARKGREY);
    lcd.setTextColor(TFT_WHITE, TFT_BLACK); lcd.drawString("CURRENT ODOMETER:", 15, 38);
    lcd.setFont(&fonts::Font2); lcd.setTextColor(themeColor, TFT_BLACK);
    snprintf(buf, sizeof(buf), "%7.1f km", virtualOdometer); lcd.drawString(buf, 140, 34);
    lcd.setFont(&fonts::Font0); lcd.setTextColor(TFT_LIGHTGREY, TFT_BLACK);
    lcd.drawString("1. ENGINE OIL (น้ำมันเครื่อง)", 15, 65);
    snprintf(buf, sizeof(buf), "Next: %6.0f km", serviceOil); lcd.drawString(buf, 205, 65);
    lcd.drawFastHLine(15, 80, 290, lcd.color565(50,50,50));
    lcd.drawString("2. TRANSMISSION FLUID (น้ำมันเกียร์)", 15, 95);
    snprintf(buf, sizeof(buf), "Next: %6.0f km", serviceGear); lcd.drawString(buf, 205, 95);
    lcd.drawFastHLine(15, 110, 290, lcd.color565(50,50,50));
    lcd.drawString("3. SPARK PLUGS (หัวเทียนอิริเดียม)", 15, 125);
    snprintf(buf, sizeof(buf), "Next: %6.0f km", servicePlug); lcd.drawString(buf, 205, 125);
    lcd.drawFastHLine(15, 140, 290, lcd.color565(50,50,50));
    lcd.fillRect(10, 212, 110, 24, lcd.color565(120, 20, 20));
    lcd.drawRect(10, 212, 110, 24, TFT_RED);
    lcd.setTextColor(TFT_WHITE, lcd.color565(120, 20, 20));
    lcd.drawString("🚀 CSV TO NAS", 18, 220);
    lcd.setTextColor(TFT_DARKGREY, TFT_BLACK);
    snprintf(buf, sizeof(buf), "Status: %s", uploadStatus.c_str());
    lcd.drawString(buf, 130, 220);
  }
  // 🟢 หน้าที่ 4: TRIP FUEL ECONOMY & MAF DATA
  else if (currentPage == 4) {
    lcd.setFont(&fonts::Font0); lcd.setTextColor(TFT_CYAN, TFT_BLACK);
    lcd.drawString("PAGE 4: TRIP FUEL ECONOMY", 10, 10);
    lcd.drawFastHLine(10, 26, 300, TFT_DARKGREY);

    lcd.setTextColor(TFT_LIGHTGREY, TFT_BLACK); lcd.drawString("TRIP DISTANCE", 18, 43);
    lcd.setFont(&fonts::Font4); lcd.setTextColor(TFT_WHITE, TFT_BLACK);
    snprintf(buf, sizeof(buf), "%.2f km", tripKm); lcd.drawString(buf, 18, 58);

    lcd.setFont(&fonts::Font0); lcd.setTextColor(TFT_LIGHTGREY, TFT_BLACK); lcd.drawString("FUEL USED (EST.)", 18, 105);
    lcd.setFont(&fonts::Font4); lcd.setTextColor(TFT_WHITE, TFT_BLACK);
    snprintf(buf, sizeof(buf), "%.3f L", tripFuelLitres); lcd.drawString(buf, 18, 120);

    lcd.setFont(&fonts::Font0); lcd.setTextColor(TFT_LIGHTGREY, TFT_BLACK); lcd.drawString("AVERAGE ECONOMY", 18, 166);
    lcd.setFont(&fonts::Font4); lcd.setTextColor(themeColor, TFT_BLACK);
    if (tripKplValid) {
      snprintf(buf, sizeof(buf), "%.2f KPL", tripKpl);
    } else {
      snprintf(buf, sizeof(buf), "--.-- KPL");
    }
    lcd.drawString(buf, 18, 181);

    // ปุ่ม RESET TRIP สีแดงซ้ายล่าง
    lcd.fillRect(10, 212, 110, 24, lcd.color565(120, 20, 20));
    lcd.drawRect(10, 212, 110, 24, TFT_RED);
    lcd.setFont(&fonts::Font0); lcd.setTextColor(TFT_WHITE, lcd.color565(120, 20, 20));
    lcd.drawString("RESET TRIP", 22, 220);

    // แสดงค่าความเร็วมวลอากาศ MAF สดๆ ด้านขวาปุ่มรีเซ็ต
    lcd.setTextColor(TFT_LIGHTGREY, TFT_BLACK);
    lcd.drawString("MAF: ", 140, 220);
    snprintf(buf, sizeof(buf), "%.1f g/s", mafGps);
    lcd.drawString(buf, 175, 220);
  }

  // 🔘 วาดปุ่ม "NEXT" ขวาล่างสุด (แสดงผลปุ่มกดหน้าจอเด่นชัดตลอดเวลา)
  lcd.fillRect(235, 212, 80, 24, lcd.color565(20, 50, 20));
  lcd.drawRect(235, 212, 80, 24, themeColor);
  lcd.setFont(&fonts::Font0); lcd.setTextColor(themeColor, lcd.color565(20, 50, 20));
  lcd.drawString("NEXT ⏩", 256, 220);

  // ⚠️ [จุดวิกฤต] คืนค่าสัญญาณบัสหน้าจอ (15) ให้เป็น HIGH ทันทีหลังจากวาดหน้าจอทั้งหมดเสร็จ
  digitalWrite(15, HIGH); 
}

  // -------------------------------------------------------------------------
  // 💾 [กลไกสำคัญ] ระบบวงจรสั่งบันทึกข้อมูลลง SD Card แบบ "อิสระเด็ดขาด"
  // -------------------------------------------------------------------------
  if (millis() - lastLogTime > 1000) {
    lastLogTime = millis();
    
    // ⚠️ ล็อกและจัดระเบียบบัส SPI ก่อนส่งข้อมูลเซฟเข้า SD Card เพื่อป้องกันทัชช้า/ค้าง
    digitalWrite(15, HIGH); // ปิดบัสหน้าจอ
    digitalWrite(33, HIGH); // ปิดบัสทัชสกรีน
    digitalWrite(5, LOW);   // เปิดบัส SD Card คุยแยกเฉพาะกิจ
    delayMicroseconds(10);
    
    logDataToSD();          // เรียกฟังก์ชันสลักค่าลงไฟล์
    
    digitalWrite(5, HIGH);  // ปิดบัส SD Card คืนระบบสู่สภาวะปกติ
    delayMicroseconds(10);
  }

  delay(5); // หน่วงสั้นมากเพียง 5ms เพื่อให้ระบบสลับหน้าประมวลผลได้อย่างราบรื่นที่สุด
}
