  WiFi.begin(ssid, password);
  unsigned long startAttempt = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - startAttempt < 6000) { delay(200); }
  
  if (WiFi.status() == WL_CONNECTED) {
    uploadStatus = "Sending...";
    HTTPClient http;
    http.begin(nas_url);
    http.addHeader("Content-Type", "text/csv");
    
    File file = SD.open(currentLogFile, FILE_READ);
    if (file) {
      int httpResponseCode = http.sendRequest("POST", (Stream*)&file, file.size());
      if (httpResponseCode > 0) uploadStatus = "Success NAS";
      else uploadStatus = "HTTP Error";
      file.close();
    } else {
      uploadStatus = "No File Log";
    }
    http.end();
  }
} // 🟢 เติมปีกกาปิดท้ายฟังก์ชันตัวนี้ที่ขาดหายไป เพื่อตัดจบไม่ให้กินฟังก์ชัน setup ครับ!


// บันทึก/โหลดค่าบำรุงรักษาลง SD Card โดยตรง: /maintenance.cfg
// รูปแบบ key=value เพื่ออ่านและแก้ไขได้จากคอมพิวเตอร์
bool saveMaintenanceConfigToSD() {
  if (!sdCardReady) { Serial.println("[CFG] SD not ready; cannot save maintenance.cfg"); return false; }
  File f = SD.open(maintenanceFile, FILE_WRITE);
  if (!f) { Serial.println("[CFG] ERROR opening maintenance.cfg for write"); return false; }
  // FILE_WRITE อาจ append บนบาง core จึงลบไฟล์เดิมก่อนเขียนใหม่
  f.close();
  SD.remove(maintenanceFile);
  f = SD.open(maintenanceFile, FILE_WRITE);
  if (!f) { Serial.println("[CFG] ERROR recreating maintenance.cfg"); return false; }
  f.printf("startOdometer=%.1f\n", startOdometer);
  f.printf("oilInterval=%.1f\n", oilInterval);
  f.printf("gearInterval=%.1f\n", gearInterval);
  f.printf("plugInterval=%.1f\n", plugInterval);
  f.printf("serviceOil=%.1f\n", serviceOil);
  f.printf("serviceGear=%.1f\n", serviceGear);
  f.printf("servicePlug=%.1f\n", servicePlug);
  f.flush(); f.close();
  Serial.println("[CFG] Saved /maintenance.cfg to SD card");
  return true;
}

void loadMaintenanceConfigFromSD() {
  if (!sdCardReady) return;
  if (!SD.exists(maintenanceFile)) {
    // ครั้งแรกสร้างไฟล์จากค่าปัจจุบัน
    serviceOil = startOdometer + oilInterval;
    serviceGear = startOdometer + gearInterval;
    servicePlug = startOdometer + plugInterval;
    saveMaintenanceConfigToSD();
    return;
  }
  File f = SD.open(maintenanceFile, FILE_READ);
  if (!f) { Serial.println("[CFG] Cannot read maintenance.cfg"); return; }
  while (f.available()) {
    String line = f.readStringUntil('\n'); line.trim();
    int eq = line.indexOf('='); if (eq <= 0) continue;
    String key = line.substring(0, eq); String val = line.substring(eq + 1); val.trim();
    float v = val.toFloat();
    if (key == "startOdometer" && v >= 0) startOdometer = v;
    else if (key == "oilInterval" && v >= 1000) oilInterval = v;
    else if (key == "gearInterval" && v >= 1000) gearInterval = v;
    else if (key == "plugInterval" && v >= 1000) plugInterval = v;
    else if (key == "serviceOil" && v >= 0) serviceOil = v;
    else if (key == "serviceGear" && v >= 0) serviceGear = v;
    else if (key == "servicePlug" && v >= 0) servicePlug = v;
  }
  f.close();
  Serial.println("[CFG] Loaded maintenance settings from SD /maintenance.cfg");
}

// อ่าน CSV ตามคอลัมน์ที่ logDataToSD() เขียน: DateTime,Odometer,Coolant,Voltage,TripKm,TripKpl,Slcd,Llcd
void analyzeLogCsvFromSD() {
  logAnalysisValid = false; logRecordCount = 0; analysisStatus = "CSV unavailable";
  if (!sdCardReady || !SD.exists(currentLogFile)) return;
  File f = SD.open(currentLogFile, FILE_READ);
  if (!f) { analysisStatus = "CSV open failed"; return; }
  while (f.available()) {
    String line = f.readStringUntil('\n'); line.trim();
    if (!line.length() || line.startsWith("DateTime") || line.startsWith("RunTime")) continue;
    // split เป็น 8 คอลัมน์ โดยไม่พึ่ง CSV library
    String cols[8]; int start = 0; bool valid = true;
    for (int i = 0; i < 7; i++) {
      int comma = line.indexOf(',', start);
      if (comma < 0) { valid = false; break; }
      cols[i] = line.substring(start, comma); start = comma + 1;
    }
    if (!valid) continue;
    cols[7] = line.substring(start);
    float odo = cols[1].toFloat();
    // ป้องกันบรรทัดผิดรูปแบบ/แถวที่ไม่มีเลขไมล์
    if (odo < 0 || (cols[1].length() == 0)) continue;
    logLastOdo = odo;
    logLastCoolant = cols[2].toFloat();
    logLastVoltage = cols[3].toFloat();
    logLastTripKpl = cols[5].toFloat();
    logLastSTFT = cols[6].toFloat();
    logLastLTFT = cols[7].toFloat();
    logRecordCount++;
    logAnalysisValid = true;
  }
  f.close();
  analysisStatus = logAnalysisValid ? "CSV analyzed" : "No valid CSV rows";
  Serial.printf("[ANALYSIS] rows=%lu odo=%.1f coolant=%.0f voltage=%.1f STFT=%.1f LTFT=%.1f\n",
    (unsigned long)logRecordCount, logLastOdo, logLastCoolant, logLastVoltage, logLastSTFT, logLastLTFT);
}



