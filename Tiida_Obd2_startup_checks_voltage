void setup() {
  Serial.begin(115200);
  delay(200);
  // ขอเวลาจริงผ่าน NTP ประเทศไทย หาก Wi-Fi เชื่อมต่อได้
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);
  unsigned long wifiStart = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - wifiStart < 5000) delay(100);
  wifiConnected = (WiFi.status() == WL_CONNECTED);
  if (wifiConnected) {
    configTime(gmtOffset_sec, daylightOffset_sec, ntpServer);
    Serial.println("[TIME] WiFi connected; NTP time requested (GMT+7)");
  } else {
    Serial.println("[TIME] WiFi unavailable; clock will show runtime until NTP sync");
  }
  settingsPrefs.begin("tiidaSetup", false);
  startOdometer = settingsPrefs.getFloat("startOdo", 245327.0);
  oilInterval = settingsPrefs.getFloat("oilInt", 5000.0);
  gearInterval = settingsPrefs.getFloat("gearInt", 40000.0);
  plugInterval = settingsPrefs.getFloat("plugInt", 100000.0);
  virtualOdometer = startOdometer;
  serviceOil = settingsPrefs.getFloat("serviceOil", startOdometer + oilInterval);
  serviceGear = settingsPrefs.getFloat("serviceGear", startOdometer + gearInterval);
  servicePlug = settingsPrefs.getFloat("servicePlug", startOdometer + plugInterval);
  settingsLoaded = true;

// 1. บังคับเปิดไฟ Backlight หน้าจอ CYD ให้สว่างทันที
  pinMode(21, OUTPUT);
  digitalWrite(21, HIGH);

  // 🟢 2. [จุดสำคัญ] สั่งล็อกขา CS ของทุกอุปกรณ์ให้อยู่สถานะ HIGH (ปิดบัส) ตั้งแต่วินาทีแรก!
  // เพื่อป้องกันไม่ให้ชิป SD Card หรือชิปทัชสกรีนแอบปล่อยสัญญาณมาสะดุดขาหน้าจอตอนเปิดเครื่อง
  pinMode(15, OUTPUT);  digitalWrite(15, HIGH); // ปิดบัสหน้าจอชั่วคราว
  pinMode(33, OUTPUT);  digitalWrite(33, HIGH); // ปิดบัสทัชสกรีน
  pinMode(5, OUTPUT);   digitalWrite(5, HIGH);  // ปิดบัส SD Card ดักไว้ก่อนเลยครับน้า

  // 3. เริ่มต้นเปิดระบบหน้าจอหลักให้เสร็จสมบูรณ์รวดเดียว
  digitalWrite(15, LOW); // เปิดเฉพาะบัสจอเพื่อให้สั่งงานได้
  lcd.init(); 
  lcd.setRotation(0); 
  lcd.fillScreen(TFT_BLACK);
  
  lcd.setFont(&fonts::Font2); lcd.setTextColor(TFT_WHITE, TFT_BLACK);
  lcd.drawString("NISSAN TIIDA OBD2", 10, 10);
  lcd.drawString("Starting system...", 10, 40);
  digitalWrite(15, HIGH); // ทำงานหน้าจอเสร็จแล้ว ปิดบัสจอคืนระบบไป
  delay(50);
  showStartupCheck("Wi-Fi", wifiConnected,
                   wifiConnected ? "Network ready" : "No Wi-Fi; continue offline");

  // 4. เริ่มเปิดท่อส่งข้อมูล SPI แยก (sdSPI) ให้กับตัว MicroSD Card
  sdSPI.begin(SD_SCLK, SD_MISO, SD_MOSI, SD_CS); // ขา 18, 19, 23, 5
  pinMode(SD_CS, OUTPUT);
  digitalWrite(SD_CS, HIGH);
  // บังคับเปิดระบบการ์ดผ่านท่อแยก ความเร็วปลอดภัย 4MHz
  bool sdSuccess = SD.begin(SD_CS, sdSPI, 5500000); 

  // 5. คืนอิสระให้บัสทั้งหมด (ปล่อย HIGH ไว้ เพื่อให้ไลบรารี LovyanGFX สลับหน้าคุยเองใน loop)
  digitalWrite(15, LOW); 
  digitalWrite(33, LOW);

  delay(50);
  // 6. ตรวจสอบการ Mount และโหลดเลขไมล์สะสม
  if (!sdSuccess) {
    Serial.println("❌ Card Mount Failed");
    sdCardReady = false;
    lcd.setTextColor(TFT_RED, TFT_BLACK);
    lcd.drawString("SD Card Failed!", 10, 70);
  } else {
    Serial.println("🟢 Card Mount Success");
    sdCardReady = true;
    
    // ดึงตัวเลขกิโลเมตรล่าสุดจาก SD Card มานับต่อทันที
    loadLatestOdometerFromSD(); 
  }
  showStartupCheck("SD Card", sdCardReady,
                   sdCardReady ? "Card mounted" : "No SD; logging disabled");
  pinMode(33, OUTPUT);
  digitalWrite(33, LOW);  // 🟩 สั่ง LOW เพื่อเปิดสวิตช์เรียกชิปทัชสกรีนให้ตื่นมารับรู้ลายนิ้วมือ
  delay(10);
  
  lcd.setRotation(0);      // บังคับให้ LovyanGFX จัดการพิกัดหน้าจอกับทัชสกรีนเป็นแนวนอนตรงกัน
  lcd.clear(); 
  // 7. บังคับสร้างไฟล์และโครงสร้างคอลัมน์ Excel ครั้งแรก
  if (sdCardReady) {
    if (!SD.exists(currentLogFile)) {
      File file = SD.open(currentLogFile, FILE_WRITE);
      if (file) {
        file.println("DateTime,Odometer,Coolant,Voltage,TripKm,TripKpl,Slcd,Llcd");
        // ไม่เขียนแถวข้อมูลตัวอย่าง เพราะไม่ใช่ค่าที่อ่านจากรถจริง
        file.flush();
        file.close();
        Serial.println("🟢 [SD Test] Created tiidalog_new.csv successfully.");
      }
    }
  }

  if (sdCardReady) {
    loadMaintenanceConfigFromSD();
    analyzeLogCsvFromSD();
  }

  // 8. เชื่อมต่อ OBD2 Bluetooth จริง (ไม่บังคับสถานะ connected)
  BLEDevice::init("");
  connected = connectToOBD2();
  Serial.println(connected ? "[OBD2] Connected" : "[OBD2] Not connected");
  showStartupCheck("Bluetooth OBD2", connected,
                   connected ? "ELM327 connected" : "OBD2 not found; retrying");
  lastFuelCalcTime = millis();
  lcd.fillScreen(TFT_BLACK);
}




void loop() {
  // ใช้ค่าที่อ่านจาก OBD2 จริงเท่านั้น ไม่มีการป้อนค่าจำลอง
  // พยายามเชื่อมต่อใหม่เมื่อ Bluetooth OBD2 หลุด
  static unsigned long lastReconnectAttempt = 0;
  // ตรวจจับการตัดการเชื่อมต่อจริง ไม่พึ่งตัวแปร connected อย่างเดียว
  if (connected && (pClient == nullptr || !pClient->isConnected())) {
    connected = false;
    pNotifyChar = nullptr;
    pWriteChar = nullptr;
    Serial.println("[BLE] OBD2 connection lost; retrying...");
  }
  if (!connected && millis() - lastReconnectAttempt >= 5000) {
    lastReconnectAttempt = millis();
    connected = connectToOBD2();
    if (connected) Serial.println("[OBD2] Reconnected");
  }
  // --- 1. ระบบเช็กทัชสกรีนสลับหน้าจอ (ปุ่ม NEXT ขวาล่าง) ---
  static unsigned long lastTouchScan = 0;
  int touchX = 0, touchY = 0;



    if (millis() - lastTouchScan >= 5) {
    lastTouchScan = millis();

    if (lcd.getTouch(&touchX, &touchY)) {
      // 🔘 ปุ่ม NEXT ขวาล่างสุด (จัดขอบเขตพิกัดให้จิ้มง่าย)
      if (touchX >= 200 && touchX <= 320 && touchY >= 170 && touchY <= 240) {
        
        // 🟢 ตรวจสอบตัวหน่วงเวลาสลับหน้า (แก้ปีกกาเปิดที่ตกหล่นให้สมบูรณ์)
        if (millis() - lastPagePress > 250) { 
          lastPagePress = millis();
          currentPage++;
          if (currentPage > 6) currentPage = 1;
          
          lcd.fillScreen(TFT_BLACK); // สั่งล้างหน้าจอเพื่อเตรียมวาดหน้าถัดไปทันที
          Serial.printf("⏩ เปลี่ยนหน้าจอสำเร็จ สลับไปหน้า: %d\n", currentPage);
        }
      }

      // หน้า 5: Setup - แตะปุ่ม -/+ เพื่อปรับค่าที่เลือก และ SAVE เพื่อบันทึก
      if (currentPage == 5 && millis() - lastPagePress > 220) {
        bool changed = false;
        float step = (setupSelected == 0) ? 100.0 : 1000.0;
        if (touchY >= 42 && touchY <= 78) setupSelected = 0;
        else if (touchY >= 82 && touchY <= 118) setupSelected = 1;
        else if (touchY >= 122 && touchY <= 158) setupSelected = 2;
        else if (touchY >= 162 && touchY <= 198) setupSelected = 3;
        if (touchX >= 190 && touchX <= 230 && touchY >= 42 && touchY <= 198) {
          if (setupSelected == 0) startOdometer = max(0.0f, startOdometer - step);
          else if (setupSelected == 1) oilInterval = max(1000.0f, oilInterval - step);
          else if (setupSelected == 2) gearInterval = max(1000.0f, gearInterval - step);
          else plugInterval = max(1000.0f, plugInterval - step);
          changed = true;
        } else if (touchX >= 270 && touchX <= 315 && touchY >= 42 && touchY <= 198) {
          if (setupSelected == 0) startOdometer += step;
          else if (setupSelected == 1) oilInterval += step;
          else if (setupSelected == 2) gearInterval += step;
          else plugInterval += step;
          changed = true;
        }
        if (touchX >= 10 && touchX <= 100 && touchY >= 202 && touchY <= 239) {
          virtualOdometer = startOdometer;
          serviceOil = virtualOdometer + oilInterval;
          serviceGear = virtualOdometer + gearInterval;
          servicePlug = virtualOdometer + plugInterval;
          bool cfgSaved = saveMaintenanceConfigToSD();
          // เก็บสำเนาใน NVS เป็น fallback แต่ SD เป็นแหล่งตั้งค่าหลัก
          settingsPrefs.putFloat("startOdo", startOdometer);
          settingsPrefs.putFloat("oilInt", oilInterval);
          settingsPrefs.putFloat("gearInt", gearInterval);
          settingsPrefs.putFloat("plugInt", plugInterval);
          settingsPrefs.putFloat("serviceOil", serviceOil);
          settingsPrefs.putFloat("serviceGear", serviceGear);
          settingsPrefs.putFloat("servicePlug", servicePlug);
          Serial.printf("[SETUP SAVED] SD=%s Start=%.0f Oil=%.0f Gear=%.0f Plugs=%.0f\n", cfgSaved ? "OK" : "FAILED", startOdometer, oilInterval, gearInterval, plugInterval);
          lcd.fillScreen(TFT_BLACK);
          lastPagePress = millis();
        } else if (changed || (touchY >= 42 && touchY <= 198)) {
          lastPagePress = millis();
          lcd.fillScreen(TFT_BLACK);
        }
      }

      // หน้า 6: แตะ REFRESH CSV เพื่ออ่านไฟล์บันทึกล่าสุดและคำนวณการเตือนใหม่
      if (currentPage == 6 && touchX >= 10 && touchX <= 140 && touchY >= 205 && touchY <= 240 && millis() - lastPagePress > 500) {
        lastPagePress = millis();
        analyzeLogCsvFromSD();
        lcd.fillScreen(TFT_BLACK);
      }

      // ปุ่มทัชสกรีน RESET TRIP (หน้า 4 ซ้ายล่าง)
      if (currentPage == 4 && touchX >= 10 && touchX <= 110 && touchY >= 190 && touchY <= 240) {
        if (millis() - lastPagePress > 250) {
          lastPagePress = millis();
          tripKm = 0.0;
          tripFuelLitres = 0.0;
          tripKpl = 0.0;
          tripKplValid = false;
          lcd.fillScreen(TFT_BLACK);
        }
      }
    }
  }

  // --- 2. ลูปยิงสลับคำสั่งวิเคราะห์ PIDs จริงจากเครื่องยนต์ Nissan Tiida ---
  if (connected) {
    static unsigned long lastQueryTime = 0; static bool waitingForData = false;
    static unsigned long queryStartedAt = 0;
    // ป้องกันคำสั่ง PID ค้างถ้า ELM327 ไม่ส่งเครื่องหมาย prompt (>) กลับมา
    if (!waitingForData && (millis() - lastQueryTime > 40)) {
      lastQueryTime = millis(); queryStartedAt = millis(); waitingForData = true;
      switch (obdState) {
        case GET_RPM:     sendOBDCommand("010C"); break;
        case GET_SPEED:   sendOBDCommand("010D"); break;
        case GET_COOLANT: sendOBDCommand("0105"); break;
        case GET_VOLTS:   sendOBDCommand("ATRV"); break; // อ่านแรงดันจาก ELM327 โดยตรง เช่น 12.6V
        case GET_IAT:     sendOBDCommand("010F"); break;
        case GET_STFT:    sendOBDCommand("0106"); break;
        case GET_LTFT:    sendOBDCommand("0107"); break;
        case GET_VACUUM:  sendOBDCommand("010B"); break;
        case GET_LOAD:    sendOBDCommand("0104"); break;
        case GET_O2:      sendOBDCommand("0114"); break;
        case GET_MAF:     sendOBDCommand("0110"); break;
      }
    }
    
    if (waitingForData && (dataReceived || millis() - queryStartedAt > 1200)) {
      bool gotPrompt = dataReceived;
      waitingForData = false;
      obdResponse.replace("\r", ""); obdResponse.replace("\n", ""); obdResponse.replace(" ", "");
      String response = obdResponse;
      if (!gotPrompt) {
        Serial.printf("[OBD TIMEOUT] PID state=%d response=%s\n", (int)obdState, response.c_str());
        // ข้าม PID ที่ไม่ตอบ เพื่อไม่ให้ข้อมูลอื่นหยุดอัปเดต
        obdState = (OBDStates)(((int)obdState + 1) % 11);
      } else if (obdResponse.indexOf("4142") >= 0 && obdState == GET_VOLTS) {
        // PID 0142: A*256+B millivolts; convert to volts
        int vIdx = obdResponse.indexOf("4142");
        String vHex = obdResponse.substring(vIdx + 4, vIdx + 8);
        float ecuV = strtol(vHex.c_str(), nullptr, 16) / 1000.0f;
        if (ecuV >= 5.0f && ecuV <= 20.0f) voltage = ecuV;
        else Serial.printf("[OBD ECU VOLTAGE] Invalid response: %s\n", response.c_str());
        obdState = GET_IAT;
      } else if (obdState == GET_VOLTS && response.indexOf('V') >= 0) {
        // ATRV ของ ELM327 มักตอบกลับเป็น "12.6V"; ใช้เป็นแรงดันระบบรถ
        String vText = response;
        int vPos = vText.indexOf('V');
        vText = vText.substring(0, vPos);
        float adapterV = vText.toFloat();
        if (adapterV >= 5.0f && adapterV <= 20.0f) {
          voltage = adapterV;
          Serial.printf("[OBD VOLTAGE] ATRV=%s -> %.2f V\\n", response.c_str(), voltage);
        } else {
          Serial.printf("[OBD VOLTAGE] Invalid ATRV response: %s\\n", response.c_str());
        }
        obdState = GET_IAT;
      } else if (obdState == GET_VOLTS && response.indexOf("NO DATA") >= 0) {
        Serial.printf("[OBD VOLTAGE] ATRV unsupported/no data: %s\\n", response.c_str());
        obdState = GET_IAT;
      } else if (obdResponse.indexOf("41") >= 0) {
        int idx = obdResponse.indexOf("41"); String dataBytes = obdResponse.substring(idx + 4);
        switch (obdState) {
          case GET_RPM: rpm = (hexToDec(dataBytes.substring(0, 2)) * 256.0 + hexToDec(dataBytes.substring(2, 4))) / 4.0; obdState = GET_SPEED; break;
          case GET_SPEED: {
            // ปรับเทียบความเร็ว OBD2 ให้ตรงกับมาตรวัดรถ: คูณ 1.1
            // เก็บเป็นจำนวนเต็ม km/h เพื่อใช้ทั้งหน้า Dashboard และคำนวณระยะทาง
            float rawSpeedKmh = (float)hexToDec(dataBytes.substring(0, 2));
            currentSpeed = (int32_t)(rawSpeedKmh * 1.1f + 0.5f);
            obdState = GET_COOLANT;
            break;
          }
          case GET_COOLANT: coolant = hexToDec(dataBytes.substring(0, 2)) - 40; obdState = GET_VOLTS; break;
          case GET_IAT: iat = hexToDec(dataBytes.substring(0, 2)) - 40; obdState = GET_STFT; break;
          case GET_STFT: stft = (hexToDec(dataBytes.substring(0, 2)) - 128) * 100.0 / 128.0; obdState = GET_LTFT; break;
          case GET_LTFT: ltft = (hexToDec(dataBytes.substring(0, 2)) - 128) * 100.0 / 128.0; obdState = GET_VACUUM; break;
          case GET_VACUUM: {
            int M_idx = obdResponse.indexOf("410B");
            if (M_idx >= 0) { float mapKpa = strtol(obdResponse.substring(M_idx + 4, M_idx + 6).c_str(), NULL, 16); vacuum = (101.3 - mapKpa) * 0.2953; if (vacuum < 0.0) vacuum = 0.0; }
            obdState = GET_LOAD; break;
          }
          case GET_LOAD: engineLoad = hexToDec(dataBytes.substring(0, 2)) * 100.0 / 255.0; obdState = GET_O2; break;
          case GET_O2: o2Sensor = hexToDec(dataBytes.substring(0, 2)) / 200.0; obdState = GET_MAF; break;
          case GET_MAF: {
            mafGps = (hexToDec(dataBytes.substring(0, 2)) * 256.0 + hexToDec(dataBytes.substring(2, 4))) / 100.0; 
            obdState = GET_RPM; break;
          }
        }
      } else {
        Serial.printf("[OBD NO DATA] state=%d response=%s\n", (int)obdState, response.c_str());
        // ถ้า PID ไม่รองรับ ให้เดินหน้าต่อ ไม่ย้อนกลับไป RPM ทุกครั้ง
        obdState = (OBDStates)(((int)obdState + 1) % 11);
      }
    }

    // =======================================================
    // 🟢 [แก้ไขใหม่] กลไกนับระยะทางและค่าน้ำมันอ้างอิงฐานเวลา 1 วินาที (ไมล์เดินชัวร์ 100%)
    // =======================================================
    static unsigned long lastOdoUpdate = 0;
    if (millis() - lastOdoUpdate >= 1000) { // บังคับคำนวณสะสมทุกๆ 1 วินาทีเต็ม
      unsigned long timeDiff = millis() - lastOdoUpdate;
      lastOdoUpdate = millis();
      
      // แปลงมิลลิวินาทีเป็นชั่วโมงสะสมก้อนใหญ่ (ประมาณ 1 / 3600 ชั่วโมง)
      float timeDiffHours = (float)timeDiff / 3600000.0;

      // 1. คำนวณระยะทางโดยประมาณจากความเร็ว OBD2 จริง เมื่อเชื่อมต่ออยู่
      if (connected && currentSpeed > 0) {
        virtualOdometer += (float)currentSpeed * timeDiffHours;
        tripKm          += (float)currentSpeed * timeDiffHours;
        
        Serial.print("🚗 ไมล์สะสมขยับเดินหน้า: "); 
        Serial.print(virtualOdometer, 4); // ปริ้นทศนิยม 4 ตำแหน่งใน Serial Monitor ให้เห็นว่าขยับจริง
        Serial.print(" km | Trip: "); Serial.println(tripKm, 4);
      }

      // 2. คำนวณค่าน้ำมันสะสม (ทำงานควบคู่กันทุกลูปวินาที)
      if (connected && mafGps > 0.0) {
        float fuelGps = mafGps / 14.7;
        float fuelLitresPerSecond = fuelGps / 740.0;
        // timeDiff / 1000.0 คือจำนวนวินาทีจริงที่ผ่านไปในรอบนั้น
        tripFuelLitres += fuelLitresPerSecond * ((float)timeDiff / 1000.0);
      }

      if (tripFuelLitres > 0.005 && tripKm > 0.02) {
        tripKpl = tripKm / tripFuelLitres;
        tripKplValid = true;
      } else {
        tripKplValid = false;
      }
    }

    // เกียร์เป็นค่าประมาณจากความเร็ว ไม่ใช่ PID เกียร์จริง; ไม่ใช้แทนข้อมูล ECU
    lastFuelCalcTime = millis();

  // --- 3. ส่วนเรนเดอร์จัดวางองค์ประกอบลงบนแผ่นหน้าจอ ---
  char buf[48]; // 🟢 แก้ไข: ขยายขนาดบัฟเฟอร์ป้องกันหน่วยความจำล้นตัวอักษรเสียหาย
  uint16_t themeColor = lcd.color565(173, 255, 47);

  // 🔴 หน้าที่ 1 — หน้าปัดหลักตามภาพตัวอย่าง
  if (currentPage == 1) {
    drawTopTachoBarDirect(rpm);

    // แถบสถานะด้านบน
    lcd.setFont(&fonts::Font0);
    lcd.setTextSize(1);
    lcd.setTextColor(themeColor, TFT_BLACK); lcd.drawString("REDLINE", 12, 10);
    lcd.setTextColor(TFT_GREEN, TFT_BLACK);  lcd.drawString(connected ? "OBD ONLINE" : "OBD OFFLINE", 105, 10);
    struct tm timeInfo;
    char clockText[12];
    if (getLocalTime(&timeInfo, 5)) strftime(clockText, sizeof(clockText), "%H:%M:%S", &timeInfo);
    else {
      unsigned long runSec = millis() / 1000;
      snprintf(clockText, sizeof(clockText), "%02lu:%02lu", (runSec / 3600) % 100, (runSec / 60) % 60);
    }
    lcd.setTextColor(TFT_WHITE, TFT_BLACK); lcd.drawString(clockText, 190, 10);

    // กรอบแสดงค่าหลักด้านซ้าย
    const uint16_t panelLine = lcd.color565(50, 190, 210);
    lcd.drawRoundRect(8, 55, 215, 172, 8, panelLine);

    // RPM — 7-segment ขนาดใหญ่ที่สุด
    lcd.fillRect(10, 65, 160, 48, TFT_BLACK);
    lcd.setFont(&fonts::Font7);
    //lcd.setTextSize(0.72);
    lcd.setTextColor(TFT_WHITE, TFT_BLACK);
    snprintf(buf, sizeof(buf), "%u", (unsigned int)rpm);
    lcd.drawString(buf, 28, 66);
    lcd.setFont(&fonts::Font0);
    lcd.setTextSize(1);
    lcd.setTextColor(themeColor, TFT_BLACK);
    lcd.drawString("RPM", 168, 88);

    // SPEED — 7-segment ขนาดกลาง
    lcd.fillRect(15, 130, 150, 40, TFT_BLACK);
    lcd.setFont(&fonts::Font7);
    lcd.setTextSize(0.58);
    lcd.setTextColor(TFT_WHITE, TFT_BLACK);
    snprintf(buf, sizeof(buf), "%03d", currentSpeed);
     lcd.drawString(buf, 45, 130);
    lcd.setFont(&fonts::Font0);
    lcd.setTextSize(1);
    lcd.setTextColor(TFT_WHITE, TFT_BLACK);
     lcd.drawString("Km/h", 168, 146);

    // ODOMETER — 7-segment ขนาดเล็กที่สุด
    lcd.fillRect(15, 180, 200, 30, TFT_BLACK);
    lcd.setFont(&fonts::Font7);
    lcd.setTextSize(0.50);
    lcd.setTextColor(TFT_WHITE, TFT_BLACK);
    snprintf(buf, sizeof(buf), "%.1f", virtualOdometer);
    lcd.drawString(buf, 65, 180);

    // กล่องข้อมูลด้านขวา
    int rx = 232, rw = 82, rh = 54;
    lcd.drawRoundRect(rx, 35, rw, rh, 6, panelLine);
    lcd.setFont(&fonts::Font0); lcd.setTextSize(1);
    lcd.setTextColor(themeColor, TFT_BLACK); lcd.drawString("COOLANT", rx+6, 40);
    lcd.setFont(&fonts::Font4); lcd.setTextSize(1);
    lcd.setTextColor(coolant >= 98 ? TFT_RED : TFT_WHITE, TFT_BLACK);
    snprintf(buf, sizeof(buf), "%2d", coolant); lcd.drawString(buf, rx+6, 52);
    lcd.setFont(&fonts::Font0); lcd.drawString("C", rx+54, 62);
    lcd.drawFastHLine(rx+6, 35 + 44, 70, lcd.color565(40, 40, 40));
    int coolantBar = constrain(map(coolant, 0, 120, 0, 70), 0, 70);
    lcd.fillRect(rx+6, 35 + 44, coolantBar, 3, themeColor);

    lcd.drawRoundRect(rx, 96, rw, rh, 6, panelLine);
    lcd.setFont(&fonts::Font0); lcd.setTextColor(themeColor, TFT_BLACK); lcd.drawString("VOLTAGE", rx+6, 101);
    lcd.setFont(&fonts::Font4); lcd.setTextColor(TFT_WHITE, TFT_BLACK);
