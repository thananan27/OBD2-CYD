void loop() {
static unsigned long lastClockUpdate = 0;
if (millis() - lastClockUpdate > 60000 || lastClockUpdate == 0) { lastClockUpdate = millis(); updateClockString(); }
// --- ทัชสกรีนควบคุม (ตรงล็อกแกนแนวนอนพอดี) ---
int touchX = 0, touchY = 0;
if (lcd.getTouch(&touchX, &touchY)) {
if (touchX >= 235 && touchX <= 320 && touchY >= 210 && touchY <= 240) {
if (millis() - lastPagePress > 500) { lastPagePress = millis(); currentPage++; if (currentPage > 4) currentPage = 1; }
}
if (currentPage == 3 && touchX >= 10 && touchX <= 120 && touchY >= 210 && touchY <= 240) {
if (millis() - lastPagePress > 800) { lastPagePress = millis(); uploadFileToNAS(); lastPage = 0; }
}
if (currentPage == 4 && touchX >= 10 && touchX <= 120 && touchY >= 210 && touchY <= 240) {
if (millis() - lastPagePress > 800) { lastPagePress = millis(); resetTrip(); lastPage = 0; }
}
}
if (connected && (pClient == nullptr || !pClient->isConnected())) { connected = false; pNotifyChar = nullptr; pWriteChar = nullptr; }
if (!connected) {
static unsigned long lastReconnectAttempt = 0;
if (millis() - lastReconnectAttempt > 2000) {
lastReconnectAttempt = millis();
connected = connectToOBD2();
if (connected) { sendOBDCommand("ATE0"); delay(150); sendOBDCommand("ATSP0"); delay(150); }
}
}
