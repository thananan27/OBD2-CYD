void uploadFileToNAS() {
  if (!sdCardReady) return;
  uploadStatus = "Sending...";
  HTTPClient http; 
  http.begin(nas_url);
  http.addHeader("Content-Type", "text/csv");
  
  // 📍 วางแทนที่บล็อกเช็กและเปิดไฟล์ตัวเดิมตรงนี้ครับ
  File file = SD.open(currentLogFile, FILE_READ);
  if (file) {
    // ใช้ (Stream*)&file เพื่อให้ข้อมูลไหลผ่านแรมทีละบล็อก บอร์ดจะไม่สลบ
    int httpResponseCode = http.sendRequest("POST", (Stream*)&file, file.size());
    if (httpResponseCode > 0) uploadStatus = "Success NAS";
    else uploadStatus = "HTTP Error";
    file.close();
  } else {
    uploadStatus = "No File Log";
  }
  
  http.end();
}


