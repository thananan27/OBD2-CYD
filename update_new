    Serial.println("Card Mount Failed");
  }
  lastFuelCalcTime = millis();
}
void loop() {
  // --- 1. ระบบเช็กทัชสกรีนสลับหน้าจอ (ปุ่ม NEXT ขวาล่าง) ---
  int touchX = 0, touchY = 0;
  if (lcd.getTouch(&touchX, &touchY)) {
    // ปุ่ม NEXT ขวาล่าง สลับหน้าจอ (ขยับพิกัดให้ตรงกับตัวรถมากขึ้น)
    if (touchX >= 220 && touchX <= 320 && touchY >= 200 && touchY <= 240) {
      if (millis() - lastPagePress > 400) {
        lastPagePress = millis();
        currentPage++;
        if (currentPage > 4) {
          currentPage = 1;
        }
        lcd.fillScreen(TFT_BLACK); 
      }
    }
    // ปุ่มกดส่งข้อมูล CSV to NAS (หน้า 3 ซ้ายล่าง)
    if (currentPage == 3 && touchX >= 10 && touchX <= 110 && touchY >= 200 && touchY <= 240) {
      if (millis() - lastPagePress > 800) {
        lastPagePress = millis();
        uploadFileToNAS();
      }
    }
    // ปุ่มทัชสกรีน RESET TRIP (หน้า 4 ซ้ายล่าง)
    if (currentPage == 4 && touchX >= 10 && touchX <= 110 && touchY >= 200 && touchY <= 240) {
      if (millis() - lastPagePress > 800) {
        lastPagePress = millis();
        tripKm = 0.0;
        tripFuelLitres = 0.0;
        tripKpl = 0.0;
        tripKplValid = false;
        lcd.fillScreen(TFT_BLACK);
      }
    }
  }

  // --- 2. ลูปยิงสลับคำสั่งวิเคราะห์ PIDs จริงจากเครื่องยนต์ Nissan Tiida ---
  if (connected) {
    static unsigned long lastQueryTime = 0; static bool waitingForData = false;
    if (!waitingForData && (millis() - lastQueryTime > 40)) {
      lastQueryTime = millis(); waitingForData = true;
      switch (obdState) {
        case GET_RPM:     sendOBDCommand("010C"); break;
        case GET_SPEED:   sendOBDCommand("010D"); break;
        case GET_COOLANT: sendOBDCommand("0105"); break;
        case GET_VOLTS:   sendOBDCommand("ATRV"); break;
        case GET_IAT:     sendOBDCommand("010F"); break;
        case GET_STFT:    sendOBDCommand("0106"); break;
        case GET_LTFT:    sendOBDCommand("0107"); break;
        case GET_VACUUM:  sendOBDCommand("010B"); break;
        case GET_LOAD:    sendOBDCommand("0104"); break;
        case GET_O2:      sendOBDCommand("0114"); break;
        case GET_MAF:     sendOBDCommand("0110"); break;
      }
    }
    
    if (waitingForData && dataReceived) {
      waitingForData = false; obdResponse.replace("\r", ""); obdResponse.replace("\n", ""); obdResponse.replace(" ", "");
      if (obdResponse.indexOf("41") >= 0) {
        int idx = obdResponse.indexOf("41"); String dataBytes = obdResponse.substring(idx + 4);
        switch (obdState) {
          case GET_RPM: rpm = (hexToDec(dataBytes.substring(0, 2)) * 256.0 + hexToDec(dataBytes.substring(2, 4))) / 4.0; obdState = GET_SPEED; break;
          case GET_SPEED: currentSpeed = hexToDec(dataBytes.substring(0, 2)); obdState = GET_COOLANT; break;
          case GET_COOLANT: coolant = hexToDec(dataBytes.substring(0, 2)) - 40; obdState = GET_VOLTS; break;
          case GET_IAT: iat = hexToDec(dataBytes.substring(0, 2)) - 40; obdState = GET_STFT; break;
          case GET_STFT: stft = (hexToDec(dataBytes.substring(0, 2)) - 128) * 100.0 / 128.0; obdState = GET_LTFT; break;
          case GET_LTFT: ltft = (hexToDec(dataBytes.substring(0, 2)) - 128) * 100.0 / 128.0; obdState = GET_VACUUM; break;
          case GET_VACUUM: {
            int M_idx = obdResponse.indexOf("410B");
            if (M_idx >= 0) { float mapKpa = strtol(obdResponse.substring(M_idx + 4, M_idx + 6).c_str(), NULL, 16); vacuum = (101.3 - mapKpa) * 0.2953; if (vacuum < 0.0) vacuum = 0.0; }
            obdState = GET_LOAD; break;
          }
          case GET_LOAD: engineLoad = hexToDec(dataBytes.substring(0, 2)) * 100.0 / 255.0; obdState = GET_O2; break;
          case GET_O2: o2Sensor = hexToDec(dataBytes.substring(0, 2)) / 200.0; obdState = GET_MAF; break;
          case GET_MAF: {
            mafGps = (hexToDec(dataBytes.substring(0, 2)) * 256.0 + hexToDec(dataBytes.substring(2, 4))) / 100.0; 
            obdState = GET_RPM; break;
          }
        }
      } else if (obdState == GET_VOLTS) {
        obdResponse.replace("V", ""); voltage = obdResponse.toFloat(); if(voltage == 0.0) voltage = 14.1;
        obdState = GET_IAT;
      } else { obdState = GET_RPM; }
    }

    // คำนวณระยะทางและเชื้อเพลิงสะสมของทริป
    unsigned long currentTime = millis();
    float timeElapsedHours = (currentTime - lastFuelCalcTime) / 3600000.0;
    lastFuelCalcTime = currentTime;
    
    if (currentSpeed > 0) {
      virtualOdometer += currentSpeed * timeElapsedHours;
      tripKm += currentSpeed * timeElapsedHours;
    }
    if (mafGps > 0.0) {
      float fuelGps = mafGps / 14.7;
      float fuelLitresPerSecond = fuelGps / 740.0;
      tripFuelLitres += fuelLitresPerSecond * (timeElapsedHours * 3600.0);
    }
    if (tripFuelLitres > 0.005 && tripKm > 0.02) {
      tripKpl = tripKm / tripFuelLitres;
      tripKplValid = true;
    } else {
      tripKplValid = false;
    }
    simulatedGear = (currentSpeed < 20) ? 1 : (currentSpeed < 50) ? 2 : (currentSpeed < 85) ? 3 : (currentSpeed < 110) ? 4 : 5;
  }

  // --- 3. ส่วนเรนเดอร์จัดวางองค์ประกอบลงบนแผ่นหน้าจอ ---
  char buf[48]; // 🟢 แก้ไข: ขยายขนาดบัฟเฟอร์ป้องกันหน่วยความจำล้นตัวอักษรเสียหาย
  uint16_t themeColor = lcd.color565(173, 255, 47);

  // 🔴 หน้าที่ 1
  if (currentPage == 1) {
    drawTopTachoBarDirect(rpm);
    lcd.setFont(&fonts::Font0);
    lcd.setTextColor(themeColor, TFT_BLACK); lcd.drawString("  REDLINE", 12, 10);
    lcd.setTextColor(TFT_GREEN, TFT_BLACK);  lcd.drawString("OBD ONLINE", 105, 10);
    lcd.setTextColor(TFT_WHITE, TFT_BLACK);  lcd.drawString("12:35", 195, 10);
    lcd.setFont(&fonts::Font7); lcd.setTextColor(TFT_WHITE, TFT_BLACK);
    lcd.fillRect(10, 65, 180, 48, TFT_BLACK); 
    if (rpm >= 1000) {
      snprintf(buf, sizeof(buf), "%d,%03u", rpm / 1000, rpm % 1000);
    } else {
      snprintf(buf, sizeof(buf), "%5u", rpm); // ใช้ %5u เพื่อดันช่องว่างให้กว้างพอดี
    }
    lcd.drawString(buf, 10, 65);
    lcd.setFont(&fonts::Font0); lcd.setTextColor(TFT_YELLOW, TFT_BLACK); lcd.drawString("RPM", 190, 95);
    lcd.setFont(&fonts::Font0); lcd.setTextColor(TFT_LIGHTGREY, TFT_BLACK); lcd.drawString("CODO:", 15, 128);
    lcd.setFont(&fonts::Font2); lcd.setTextColor(themeColor, TFT_BLACK);
    snprintf(buf, sizeof(buf), "%7.1f km", virtualOdometer); lcd.drawString(buf, 50, 124);
    lcd.drawRoundRect(8, 55, 215, 172, 8, lcd.color565(50, 50, 50));
    lcd.setFont(&fonts::Font0); lcd.setTextColor(themeColor, TFT_BLACK); lcd.drawString("SPEED", 20, 205);
    lcd.setFont(&fonts::Font4); lcd.setTextColor(TFT_WHITE, TFT_BLACK);
    snprintf(buf, sizeof(buf), "%03d", currentSpeed); lcd.drawString(buf, 68, 192);
    lcd.setFont(&fonts::Font0); lcd.setTextColor(TFT_LIGHTGREY, TFT_BLACK); lcd.drawString("km/h", 145, 205);
    lcd.setTextColor(TFT_YELLOW, TFT_BLACK); lcd.drawString("GEAR", 185, 205);
    lcd.setFont(&fonts::Font4); lcd.setTextColor(TFT_YELLOW, TFT_BLACK);
    snprintf(buf, sizeof(buf), "%d", simulatedGear); lcd.drawString(buf, 222, 192);
    int rx = 232, rw = 82, rh = 54;
    lcd.drawRoundRect(rx, 35, rw, rh, 6, lcd.color565(60, 60, 60));
    lcd.setFont(&fonts::Font0); lcd.setTextColor(themeColor, TFT_BLACK); lcd.drawString("COOLANT", rx+6, 40);
    lcd.setFont(&fonts::Font4); lcd.setTextColor(coolant >= 98 ? TFT_RED : TFT_WHITE, TFT_BLACK); snprintf(buf, sizeof(buf), "%2d", coolant); lcd.drawString(buf, rx+6, 52);
    lcd.setFont(&fonts::Font0); lcd.drawString("C", rx+54, 62);
    lcd.drawFastHLine(rx+6, 35 + 44, 70, lcd.color565(40, 40, 40)); 
    lcd.fillRect(rx+6, 35 + 44, map(coolant, 0, 120, 0, 70), 3, themeColor);
    lcd.drawRoundRect(rx, 96, rw, rh, 6, lcd.color565(60, 60, 60));
    lcd.setFont(&fonts::Font0); lcd.setTextColor(themeColor, TFT_BLACK); lcd.drawString("VOLTAGE", rx+6, 101);
    lcd.setFont(&fonts::Font4); lcd.setTextColor(themeColor, TFT_BLACK); snprintf(buf, sizeof(buf), "%4.1f", voltage); lcd.drawString(buf, rx+4, 113);
    lcd.setFont(&fonts::Font0); lcd.drawString("V", rx+66, 123);
    lcd.drawRoundRect(rx, 157, rw, rh, 6, lcd.color565(60, 60, 60));
    lcd.setFont(&fonts::Font0); lcd.setTextColor(themeColor, TFT_BLACK); lcd.drawString("INTAKE", rx+6, 162);
    lcd.setFont(&fonts::Font4); lcd.setTextColor(TFT_WHITE, TFT_BLACK); snprintf(buf, sizeof(buf), "%2d", iat); lcd.drawString(buf, rx+6, 174);
    lcd.setFont(&fonts::Font0); lcd.drawString("C", rx+54, 184);
  }
  // 🟦 หน้าที่ 2
  else if (currentPage == 2) {
    lcd.setFont(&fonts::Font0); lcd.setTextColor(TFT_ORANGE, TFT_BLACK); lcd.drawString("PAGE 2: ECU DIAGNOSTIC DATA MONITOR", 10, 10);
