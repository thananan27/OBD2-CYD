<?php
// 1. ตั้งค่าการเชื่อมต่อฐานข้อมูล MySQL
$servername = "localhost";
$username = "root"; 
$password = "";     
$dbname = "obdii";

$conn = new mysqli($servername, $username, $password, $dbname);
if ($conn->connect_error) {
    die("Connection failed: " . $conn->connect_error);
}

// 2. ลอจิกปุ่มกดลบข้อมูลล้างค่าของวันนี้ (Clear Data Trigger)
if (isset($_POST['action']) && $_POST['action'] == 'clear_today') {
    $current_date = date('Y-m-d');
    $sql_delete = "DELETE FROM vehicle_logs WHERE DATE(DateTime) = '$current_date'";
    if ($conn->query($sql_delete) === TRUE) {
        echo "<script>alert('ลบข้อมูลของวันนี้ออกเรียบร้อยแล้ว!'); window.location.href='dashboard.php';</script>";
    } else {
        echo "<script>alert('เกิดข้อผิดพลาด: " . $conn->error . "');</script>";
    }
}

// 3. ระบบเลือกดูข้อมูลย้อนหลังตามวัน (เริ่มต้นเป็นวันปัจจุบันหากไม่ได้ค้นหา)
$selected_date = isset($_GET['search_date']) ? $_GET['search_date'] : date('Y-m-d');

// 4. ดึงข้อมูลแถวล่าสุด (Current Status) ของวันที่เลือกมาแสดงในกล่องข้อความ
$sql_latest = "SELECT * FROM vehicle_logs WHERE DATE(DateTime) = '$selected_date' ORDER BY DateTime DESC LIMIT 1";
$result_latest = $conn->query($sql_latest);
$latest = $result_latest->fetch_assoc();

// หากวันนั้นไม่มีข้อมูลเลย ให้ดึงแถวล่าสุดจริงๆ ในตารางมาโชว์ก่อนเพื่อไม่ให้หน้าจอว่างเปล่า
if (!$latest) {
    $sql_latest = "SELECT * FROM vehicle_logs ORDER BY DateTime DESC LIMIT 1";
    $result_latest = $conn->query($sql_latest);
    $latest = $result_latest->fetch_assoc();
}

// 5. ดึงข้อมูลสำหรับพล็อตลง 2 กราฟย่อย (จำกัด 100 แถวล่าสุดตามวันที่เลือก)
$sql_chart = "SELECT DateTime, Rpm, Speed, engineLoad, Slcd, Llcd, O2Sensor FROM vehicle_logs WHERE DATE(DateTime) = '$selected_date' ORDER BY DateTime DESC LIMIT 100";
$result_chart = $conn->query($sql_chart);

$chart_labels = [];
$chart_rpm = [];
$chart_speed = [];
$chart_load = [];
$chart_trim = [];
$chart_o2 = [];

while($row = $result_chart->fetch_assoc()) {
    array_unshift($chart_labels, date('H:i:s', strtotime($row['DateTime'])));
    array_unshift($chart_rpm, $row['Rpm']);
    array_unshift($chart_speed, $row['Speed']);
    array_unshift($chart_load, $row['engineLoad']);
    array_unshift($chart_trim, ($row['Slcd'] + $row['Llcd'])); // รวมค่าชดเชยน้ำมันสั้นและยาวตรงนี้
    array_unshift($chart_o2, $row['O2Sensor']);
}

// 6. ดึงข้อมูลเหตุการณ์ที่ค่า Slcd + Llcd รวมกันมากกว่า 10 (Fuel Trim ผิดปกติ) เพื่อโชว์ในตาราง
$sql_alerts = "SELECT DateTime, Slcd, Llcd, O2Sensor, Vacuum, engineLoad, Speed, Rpm 
               FROM vehicle_logs 
               WHERE (Slcd + Llcd) > 10 AND DATE(DateTime) = '$selected_date'
               ORDER BY DateTime DESC";
$result_alerts = $conn->query($sql_alerts);

$conn->close();
?>

