void setup() {
  Serial.begin(115200);
  delay(200); 

  // 1. บังคับเปิดไฟ Backlight หน้าจอ CYD ให้สว่างทันที
  pinMode(21, OUTPUT);
  digitalWrite(21, HIGH);

  // 🟢 2. [จุดสำคัญ] สั่งล็อกขา CS ของทุกอุปกรณ์ให้อยู่สถานะ HIGH (ปิดบัส) ตั้งแต่วินาทีแรก!
  // เพื่อป้องกันไม่ให้ชิป SD Card หรือชิปทัชสกรีนแอบปล่อยสัญญาณมาสะดุดขาหน้าจอตอนเปิดเครื่อง
  pinMode(15, OUTPUT);  digitalWrite(15, HIGH); // ปิดบัสหน้าจอชั่วคราว
  pinMode(33, OUTPUT);  digitalWrite(33, HIGH); // ปิดบัสทัชสกรีน
  pinMode(5, OUTPUT);   digitalWrite(5, HIGH);  // ปิดบัส SD Card ดักไว้ก่อนเลยครับน้า

  // 3. เริ่มต้นเปิดระบบหน้าจอหลักให้เสร็จสมบูรณ์รวดเดียว
  digitalWrite(15, LOW); // เปิดเฉพาะบัสจอเพื่อให้สั่งงานได้
  lcd.init(); 
  lcd.setRotation(0); 
  lcd.fillScreen(TFT_BLACK);
  
  lcd.setFont(&fonts::Font2); lcd.setTextColor(TFT_WHITE, TFT_BLACK);
  lcd.drawString("NISSAN TIIDA OBD2 CLUSTER", 10, 10);
  lcd.drawString("Initializing SD Card...", 10, 40);
  digitalWrite(15, HIGH); // ทำงานหน้าจอเสร็จแล้ว ปิดบัสจอคืนระบบไป
  delay(50);

  // 4. เริ่มเปิดท่อส่งข้อมูล SPI แยก (sdSPI) ให้กับตัว MicroSD Card
  sdSPI.begin(SD_SCLK, SD_MISO, SD_MOSI, SD_CS); // ขา 18, 19, 23, 5
  pinMode(SD_CS, OUTPUT);
  digitalWrite(SD_CS, HIGH);
  // บังคับเปิดระบบการ์ดผ่านท่อแยก ความเร็วปลอดภัย 4MHz
  bool sdSuccess = SD.begin(SD_CS, sdSPI, 5500000); 

  // 5. คืนอิสระให้บัสทั้งหมด (ปล่อย HIGH ไว้ เพื่อให้ไลบรารี LovyanGFX สลับหน้าคุยเองใน loop)
  digitalWrite(15, LOW); 
  digitalWrite(33, LOW);
  delay(50);
  // 6. ตรวจสอบการ Mount และโหลดเลขไมล์สะสม
  if (!sdSuccess) {
    Serial.println("❌ Card Mount Failed");
    sdCardReady = false;
    lcd.setTextColor(TFT_RED, TFT_BLACK);
    lcd.drawString("SD Card Failed!", 10, 70);
  } else {
    Serial.println("🟢 Card Mount Success");
    sdCardReady = true;
    
    // ดึงตัวเลขกิโลเมตรล่าสุดจาก SD Card มานับต่อทันที
    loadLatestOdometerFromSD(); 
  }
  pinMode(33, OUTPUT);
  digitalWrite(33, HIGH);  // 🟩 สั่ง LOW เพื่อเปิดสวิตช์เรียกชิปทัชสกรีนให้ตื่นมารับรู้ลายนิ้วมือ
  delay(10);
  
  lcd.setRotation(0);      // บังคับให้ LovyanGFX จัดการพิกัดหน้าจอกับทัชสกรีนเป็นแนวนอนตรงกัน
  lcd.clear(); 
  // 7. บังคับสร้างไฟล์และโครงสร้างคอลัมน์ Excel ครั้งแรก
  if (sdCardReady) {
    if (!SD.exists(currentLogFile)) {
      File file = SD.open(currentLogFile, FILE_WRITE);
      if (file) {
        file.println("DateTime,Odometer,Coolant,Voltage,TripKm,TripKpl,Slcd,Llcd");
        file.println("RunTime 00:00:00,245327.0,80,14.1,0.00,0.00,+0.0,+0.0");
        file.flush();
        file.close();
        Serial.println("🟢 [SD Test] Created tiidalog_new.csv successfully.");
      }
    }
  }

  // 8. ตั้งค่านาฬิกาและข้ามระบบค้นหาบลูทูธเพื่อเทสในบ้านชั่วคราว
  connected = true; 
  lastFuelCalcTime = millis();
  lcd.fillScreen(TFT_BLACK);
}




void loop() {
  // =======================================================
  // 🟢 [สำหรับทดสอบในบ้าน] บังคับจำลองค่าเพื่อให้ไมล์เดินและ SD Card ทำงาน
  // =======================================================
  connected = true;       // หลอกบอร์ดว่าเชื่อมต่อรถแล้ว
  currentSpeed = 80;      // สมมุติว่าขับรถอยู่ที่ความเร็ว 80 km/h
  rpm = 2500;             // สมมุติรอบเครื่องอยู่ที่ 2500 RPM
  coolant = 85;           // สมมุติความร้อน 85 องศา
  voltage = 14.0;         // สมมุติโวลต์แบตเตอรี่ 14.0V
  stft = 1.2;             // สมมุติค่า Trim
  ltft = -0.5;
  mafGps = 4.5;           // ใส่ค่า MAF จำลองเพื่อให้ระบบน้ำมันทำงาน
  // =======================================================
  // --- 1. ระบบเช็กทัชสกรีนสลับหน้าจอ (ปุ่ม NEXT ขวาล่าง) ---
  static unsigned long lastTouchScan = 0;
  int touchX = 0, touchY = 0;

  // ตรวจทัชทุกครั้งที่ loop วนกลับมา (อย่างน้อยทุก 5 ms เมื่อไม่มีงานบล็อก)
  // หมายเหตุ: การวาดจอ/เขียน SD อาจทำให้ loop ช้าลงชั่วคราว
  if (millis() - lastTouchScan >= 5) {
    lastTouchScan = millis();
    
    if (lcd.getTouch(&touchX, &touchY)) {
      // 🔘 ปุ่ม NEXT ขวาล่างสุด (ขยายขอบเขตพิกัดเพิ่มความกว้างให้จิ้มง่ายดายขึ้น)
      if (touchX >= 200 && touchX <= 320 && touchY >= 170 && touchY <= 240) {
        if (millis() - lastPagePress > 350) { // ลดตัวหน่วงการเปลี่ยนหน้าให้เหลือแค่ 300ms
          lastPagePress = millis();
          currentPage++;
          if (currentPage > 4) currentPage = 1;
          
          lcd.fillScreen(TFT_BLACK); // ล้างเฟรมจอเพื่อวาดหน้าปัดชุดถัดไปทันที
          Serial.printf("⏩ ดีดเปลี่ยนหน้าจอทันใจ สลับไปหน้าย่อยที่: %d\n", currentPage);
        }
      }

      // ปุ่มทัชสกรีน RESET TRIP (หน้า 4 ซ้ายล่าง)
      if (currentPage == 4 && touchX >= 10 && touchX <= 110 && touchY >= 190 && touchY <= 240) {
        if (millis() - lastPagePress > 800) {
          lastPagePress = millis();
          tripKm = 0.0;
          tripFuelLitres = 0.0;
          tripKpl = 0.0;
          tripKplValid = false;
          lcd.fillScreen(TFT_BLACK);
        }
      }
    }
  }

  // --- 2. ลูปยิงสลับคำสั่งวิเคราะห์ PIDs จริงจากเครื่องยนต์ Nissan Tiida ---
  if (connected) {
    static unsigned long lastQueryTime = 0; static bool waitingForData = false;
    if (!waitingForData && (millis() - lastQueryTime > 40)) {
      lastQueryTime = millis(); waitingForData = true;
      switch (obdState) {
        case GET_RPM:     sendOBDCommand("010C"); break;
        case GET_SPEED:   sendOBDCommand("010D"); break;
        case GET_COOLANT: sendOBDCommand("0105"); break;
        case GET_VOLTS:   sendOBDCommand("ATRV"); break;
        case GET_IAT:     sendOBDCommand("010F"); break;
        case GET_STFT:    sendOBDCommand("0106"); break;
        case GET_LTFT:    sendOBDCommand("0107"); break;
        case GET_VACUUM:  sendOBDCommand("010B"); break;
        case GET_LOAD:    sendOBDCommand("0104"); break;
        case GET_O2:      sendOBDCommand("0114"); break;
        case GET_MAF:     sendOBDCommand("0110"); break;
      }
    }
    
    if (waitingForData && dataReceived) {
      waitingForData = false; obdResponse.replace("\r", ""); obdResponse.replace("\n", ""); obdResponse.replace(" ", "");
      if (obdResponse.indexOf("41") >= 0) {
        int idx = obdResponse.indexOf("41"); String dataBytes = obdResponse.substring(idx + 4);
        switch (obdState) {
          case GET_RPM: rpm = (hexToDec(dataBytes.substring(0, 2)) * 256.0 + hexToDec(dataBytes.substring(2, 4))) / 4.0; obdState = GET_SPEED; break;
          case GET_SPEED: currentSpeed = hexToDec(dataBytes.substring(0, 2)); obdState = GET_COOLANT; break;
          case GET_COOLANT: coolant = hexToDec(dataBytes.substring(0, 2)) - 40; obdState = GET_VOLTS; break;
          case GET_IAT: iat = hexToDec(dataBytes.substring(0, 2)) - 40; obdState = GET_STFT; break;
          case GET_STFT: stft = (hexToDec(dataBytes.substring(0, 2)) - 128) * 100.0 / 128.0; obdState = GET_LTFT; break;
          case GET_LTFT: ltft = (hexToDec(dataBytes.substring(0, 2)) - 128) * 100.0 / 128.0; obdState = GET_VACUUM; break;
          case GET_VACUUM: {
            int M_idx = obdResponse.indexOf("410B");
            if (M_idx >= 0) { float mapKpa = strtol(obdResponse.substring(M_idx + 4, M_idx + 6).c_str(), NULL, 16); vacuum = (101.3 - mapKpa) * 0.2953; if (vacuum < 0.0) vacuum = 0.0; }
            obdState = GET_LOAD; break;
          }
          case GET_LOAD: engineLoad = hexToDec(dataBytes.substring(0, 2)) * 100.0 / 255.0; obdState = GET_O2; break;
          case GET_O2: o2Sensor = hexToDec(dataBytes.substring(0, 2)) / 200.0; obdState = GET_MAF; break;
          case GET_MAF: {
            mafGps = (hexToDec(dataBytes.substring(0, 2)) * 256.0 + hexToDec(dataBytes.substring(2, 4))) / 100.0; 
            obdState = GET_RPM; break;
          }
        }
      } else if (obdState == GET_VOLTS) {
        obdResponse.replace("V", ""); voltage = obdResponse.toFloat(); if(voltage == 0.0) voltage = 14.1;
        obdState = GET_IAT;
      } else { obdState = GET_RPM; }
    }

