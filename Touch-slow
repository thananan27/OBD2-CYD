    file.print(coolant);                    file.print(",");
    file.print(String(voltage, 1));         file.print(",");
    file.print(String(tripKm, 2));          file.print(",");
    file.print(String(tripKpl, 2));         file.print(",");
    file.print(String(stft, 1));            file.print(",");
    file.println(String(ltft, 1));          // บันทึกค่าสุดท้ายเสร็จแล้วปัดขึ้นบรรทัดใหม่ทันที
    
    file.flush(); // บังคับเซฟลงการ์ดทันทีป้องกันไฟล์เสีย
    file.close(); 
    Serial.print("💾 SD Saved Auto with Time: "); Serial.println(timeStringBuff);
  } else {
    Serial.println("❌ SD Card Write Error!");
  }
}


// 🔄 2. ฟังก์ชันดึงเลขไมล์กิโลเมตรล่าสุดจาก SD Card กลับมานับต่อตอนเปิดเครื่อง
// 🔄 ฟังก์ชันอ่านเลขไมล์ล่าสุดจาก SD Card (เวอร์ชันเจาะจงคอมมาช่องที่ 2 ดึงค่าแม่นยำ 100%)
void loadLatestOdometerFromSD() {
  if (!SD.exists(currentLogFile)) {
    Serial.println("ℹ️ No log file found. Using default odometer.");
    return;
  }
  
  // จัดระเบียบลำดับบัสสลับช่องสัญญาณดักหน้าจอค้าง
  digitalWrite(15, HIGH); 
  digitalWrite(33, HIGH);
  digitalWrite(5, LOW);
  delay(10);

  File file = SD.open(currentLogFile, FILE_READ);
  if (file) {
    String lastLine = "";
    
    // วนลูปสแกนหาบรรทัดล่าสุดล่างสุดของไฟล์จริง
    while (file.available()) {
      String line = file.readStringUntil('\n');
      line.trim();
      if (line.length() > 0) {
        lastLine = line; // เก็บประวัติบรรทัดล่าสุดไว้
      }
    }
    file.close();
    
    // 🟩 ถอดรหัสเจาะหาตัวเลข Odometer ระหว่างคอมมาตัวที่ 1 และตัวที่ 2
    if (lastLine.length() > 0) {
      int firstComma = lastLine.indexOf(',');
      if (firstComma > 0) {
        // หาคอมมาตัวที่สองถัดไป
        int secondComma = lastLine.indexOf(',', firstComma + 1);
        if (secondComma > firstComma) {
          // ดึงข้อความเฉพาะช่องที่สองซึ่งเป็นตัวเลขไมล์ล้วนๆ
          String odoStr = lastLine.substring(firstComma + 1, secondComma);
          odoStr.trim();
          
          float savedOdo = odoStr.toFloat();
          if (savedOdo > 100.0) { // ดักค่าเออเร่อกรณีเป็น 0
            virtualOdometer = savedOdo;
            Serial.print("💾 [SD Success] Loaded Odometer from Card: ");
            Serial.println(virtualOdometer, 1);
          }
        }
      }
    }
  }

  // คืนสัญญาณระบบจราจรบัสหลักกลับสู่จอและทัชสกรีน
  digitalWrite(5, HIGH);
  digitalWrite(15, HIGH); 
//  digitalWrite(33, LOW); 
  delay(10);
}




void uploadFileToNAS() {
  uploadStatus = "Saving SD...";
  uploadStatus = "WiFi Conn...";
  WiFi.begin(ssid, password);
  unsigned long startAttempt = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - startAttempt < 6000) { delay(200); }
  
  if (WiFi.status() == WL_CONNECTED) {
    uploadStatus = "Sending...";
    HTTPClient http;
    http.begin(nas_url);
    http.addHeader("Content-Type", "text/csv");
    
    File file = SD.open(currentLogFile, FILE_READ);
    if (file) {
      int httpResponseCode = http.sendRequest("POST", (Stream*)&file, file.size());
      if (httpResponseCode > 0) uploadStatus = "Success NAS";
      else uploadStatus = "HTTP Error";
      file.close();
    } else {
      uploadStatus = "No File Log";
    }
    http.end();
  }
